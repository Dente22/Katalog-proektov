{
  "name": "project-cards",
  "productName": "Каталог проектов",
  "version": "1.1.3",
  "description": "Desktop catalog of project folders with card.md descriptions",
  "author": "Project Cards",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --config electron-builder.json --win && node scripts/write-update-manifest.js",
    "dist:dir": "electron-builder --config electron-builder.json --win dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
