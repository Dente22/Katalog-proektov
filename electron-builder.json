{
  "appId": "local.project-cards",
  "productName": "Каталог проектов",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "renderer/**/*",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icons/icon.ico"
    },
    {
      "from": "build/icon.png",
      "to": "icons/icon.png"
    },
    {
      "from": "assets",
      "to": "assets"
    },
    {
      "from": ".cursor/skills",
      "to": "skills-template"
    },
    {
      "from": "defaults/user-config.json",
      "to": "defaults/project-cards-config.json"
    }
  ],
  "icon": "build/icon.ico",
  "afterPack": "./scripts/after-pack.js",
  "artifactName": "Katalog-proektov-Setup-${version}.${ext}",
  "forceCodeSigning": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "executableName": "ProjectCatalog",
    "signAndEditExecutable": false,
    "signDlls": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Каталог проектов",
    "uninstallDisplayName": "Каталог проектов",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "installerLanguages": ["ru_RU", "en_US"],
    "unicode": true,
    "include": "build/installer.nsh",
    "warningsAsErrors": false
  }
}
